{
  "name": "@bemedev/hook-wrapper",
  "version": "1.0.0",
  "description": "Wrapper of hooks to render them in a component without recreating them.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "module": "lib/index.js",
  "files": [
    "lib"
  ],
  "homepage": "https://hook-wrapper--bemedev.vercel.app",
  "author": {
    "email": "bri_lvi@icloud.com",
    "name": "chlbri",
    "url": "https://bemedev.vercel.app"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chlbri/react-hook-wrapper"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types.d.ts",
      "import": "./lib/types.js",
      "default": "./lib/types.js"
    },
    "./component": {
      "types": "./lib/wrapper.component.d.ts",
      "import": "./lib/wrapper.component.js",
      "default": "./lib/wrapper.component.js"
    },
    "./package.json": "./package.json"
  },
  "maintainers": [
    {
      "email": "bri_lvi@icloud.com",
      "name": "chlbri",
      "url": "https://bemedev.vercel.app"
    }
  ],
  "contributors": [
    {
      "email": "bri_lvi@icloud.com",
      "name": "chlbri",
      "url": "https://bemedev.vercel.app"
    }
  ],
  "keywords": [
    "react",
    "hook",
    "wrapper"
  ],
  "scripts": {
    "p-q": "pretty-quick",
    "posttest": "vp fmt",
    "pretest": "vp run pack",
    "publish:first": "vp run pretest && pnpm publish --access public --no-git-checks",
    "rm:lib": "vp dlx rimraf ./lib"
  },
  "devDependencies": {
    "@bemedev/dev-utils": "^1.6.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "pretty-quick": "^4.2.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rimraf": "^6.1.4",
    "typescript": "7.0.2",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
